<Window
    x:Class="PopTranslate.App.Windows.FloatingHoverIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PopTranslate Hover">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Border
            x:Name="PillBorder"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Button
                x:Name="TranslateActionButton"
                MinWidth="0"
                MinHeight="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="0"
                CornerRadius="7"
                BorderThickness="0"
                Background="Transparent"
                AutomationProperties.Name="翻译选中文本"
                ToolTipService.ToolTip="左键翻译选中文本 · 右键替换翻译、设置或退出"
                Click="TranslateActionButton_Click">
                <TextBlock
                    Text="译"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Button>
        </Border>
    </Grid>
</Window>
