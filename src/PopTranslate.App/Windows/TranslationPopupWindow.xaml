<winex:WindowEx
    x:Class="PopTranslate.App.Windows.TranslationPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    xmlns:controls="using:PopTranslate.App.Controls"
    xmlns:vm="using:PopTranslate.App.ViewModels"
    Title="PopTranslate"
    Width="460"
    Height="340"
    MinWidth="360"
    MaxWidth="760"
    IsTitleBarVisible="False"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="True">

    <Grid
        x:Name="RootContainer"
        Background="Transparent"
        PreviewKeyDown="RootContainer_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Single Spacious Draggable Top Header Row -->
        <Grid
            x:Name="TopToolbarGrid"
            Grid.Row="0"
            Padding="16,12,14,10"
            Background="Transparent"
            ColumnSpacing="8"
            PointerPressed="TopToolbarGrid_PointerPressed"
            PointerMoved="TopToolbarGrid_PointerMoved"
            PointerReleased="TopToolbarGrid_PointerReleased"
            PointerCaptureLost="TopToolbarGrid_PointerCaptureLost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Clean Fluent 2 Language Pill Group (Zero Bulky ComboBox Chrome) -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Height="32"
                Spacing="6"
                VerticalAlignment="Center">
                <Button
                    x:Name="SourceLangButton"
                    Style="{StaticResource PopTranslateLanguagePillButtonStyle}"
                    AutomationProperties.Name="源语言"
                    ToolTipService.ToolTip="选择源语言">
                    <Button.Flyout>
                        <MenuFlyout
                            x:Name="SourceLangMenuFlyout"
                            Placement="BottomEdgeAlignedLeft"
                            ShouldConstrainToRootBounds="False"
                            Opening="SourceLangMenuFlyout_Opening"
                            Closed="InternalFlyout_Closed" />
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12.5"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.SourceLanguageButtonText, Mode=OneWay}" />
                        <FontIcon
                            FontSize="9"
                            Glyph="&#xE70D;"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button
                    Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                    Command="{x:Bind ViewModel.SwapLanguagesCommand}"
                    AutomationProperties.Name="互换源语言与目标语言"
                    ToolTipService.ToolTip="互换源语言与目标语言 (Alt+S)">
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xE8AB;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <Button
                    x:Name="TargetLangButton"
                    Style="{StaticResource PopTranslateLanguagePillButtonStyle}"
                    AutomationProperties.Name="目标语言"
                    ToolTipService.ToolTip="选择目标语言">
                    <Button.Flyout>
                        <MenuFlyout
                            x:Name="TargetLangMenuFlyout"
                            Placement="BottomEdgeAlignedLeft"
                            ShouldConstrainToRootBounds="False"
                            Opening="TargetLangMenuFlyout_Opening"
                            Closed="InternalFlyout_Closed" />
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.TargetLanguageButtonText, Mode=OneWay}" />
                        <FontIcon
                            FontSize="9"
                            Glyph="&#xE70D;"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Column 1 (*): Draggable Empty Header Space -->

            <!-- Right: 32x32 (CornerRadius=6) Ghost Window Micro-Toolbar (Zero Solid ToggleButtons!) -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">

                <!-- ↵ Merge Line Breaks Subtle Tinted Ghost Button -->
                <Button
                    Style="{StaticResource PopTranslateHeaderGhostButtonStyle}"
                    Command="{x:Bind ViewModel.ToggleMergeLineBreaksCommand}"
                    AutomationProperties.Name="智能合并换行"
                    ToolTipService.ToolTip="{x:Bind ViewModel.MergeLineBreaksTooltip, Mode=OneWay}">
                    <Grid Width="32" Height="32">
                        <Border
                            Visibility="{x:Bind ViewModel.MergeLineBreaks, Mode=OneWay}"
                            Background="{ThemeResource PopTranslateAccentSubtleBackgroundBrush}"
                            BorderBrush="{ThemeResource PopTranslateAccentSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <FontIcon
                                FontSize="13"
                                Glyph="&#xE751;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <Border
                            Visibility="{x:Bind ViewModel.IsMergeLineBreaksOff, Mode=OneWay}"
                            CornerRadius="6">
                            <FontIcon
                                FontSize="13"
                                Glyph="&#xE751;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>
                </Button>

                <!-- 📌 Pin Subtle Tinted Ghost Button -->
                <Button
                    Style="{StaticResource PopTranslateHeaderGhostButtonStyle}"
                    Command="{x:Bind ViewModel.TogglePinCommand}"
                    AutomationProperties.Name="置顶锁定弹窗"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PinTooltip, Mode=OneWay}">
                    <Grid Width="32" Height="32">
                        <Border
                            Visibility="{x:Bind ViewModel.IsPinned, Mode=OneWay}"
                            Background="{ThemeResource PopTranslateAccentSubtleBackgroundBrush}"
                            BorderBrush="{ThemeResource PopTranslateAccentSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <FontIcon
                                FontSize="13"
                                Glyph="&#xE840;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <Border
                            Visibility="{x:Bind ViewModel.IsUnpinned, Mode=OneWay}"
                            CornerRadius="6">
                            <FontIcon
                                FontSize="13"
                                Glyph="&#xE718;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>
                </Button>

                <!-- 📷 Screenshot -->
                <Button
                    Style="{StaticResource PopTranslateHeaderGhostButtonStyle}"
                    Click="ScreenshotButton_Click"
                    AutomationProperties.Name="截图翻译"
                    ToolTipService.ToolTip="截图翻译">
                    <FontIcon
                        FontSize="13"
                        Glyph="&#xE722;"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- ⚙ Settings -->
                <Button
                    Style="{StaticResource PopTranslateHeaderGhostButtonStyle}"
                    Click="SettingsButton_Click"
                    AutomationProperties.Name="打开设置"
                    ToolTipService.ToolTip="打开设置">
                    <FontIcon
                        FontSize="13"
                        Glyph="&#xE713;"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- ✕ Close -->
                <Button
                    x:Name="ClosePopupButton"
                    Style="{StaticResource PopTranslateHeaderGhostButtonStyle}"
                    Click="ClosePopupButton_Click"
                    AutomationProperties.Name="关闭弹窗"
                    ToolTipService.ToolTip="关闭弹窗 (Esc)">
                    <FontIcon
                        FontSize="11.5"
                        Glyph="&#xE8BB;"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Spacious Adaptive Source Section (OCR Context + 38px Collapsed Bar / Expanded Input Card) -->
        <StackPanel
            x:Name="SourceSectionPanel"
            Grid.Row="1"
            Margin="16,0,16,12"
            Spacing="8"
            SizeChanged="CardsContentPanel_SizeChanged">

            <!-- Collapsible OCR Context Bar & Screenshot Preview -->
            <Border
                Visibility="{x:Bind ViewModel.HasOcrContext, Mode=OneWay}"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,6">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Style="{StaticResource PopTranslateMicroChipButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleOcrPreviewCommand}"
                            AutomationProperties.Name="查看或收起截图预览"
                            ToolTipService.ToolTip="展开或收起原始截图缩略图">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon
                                    FontSize="11"
                                    Glyph="&#xEB9F;"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    FontSize="11.5"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.OcrPreviewToggleLabel, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="9"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="{x:Bind ViewModel.OcrPreviewChevronGlyph, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Height="26"
                            Padding="8,0,7,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="OCR 识别模式"
                            ToolTipService.ToolTip="切换 OCR 识别模式并重新识别">
                            <Button.Flyout>
                                <MenuFlyout
                                    x:Name="OcrModeMenuFlyout"
                                    Placement="BottomEdgeAlignedRight"
                                    ShouldConstrainToRootBounds="False"
                                    Opening="OcrModeMenuFlyout_Opening"
                                    Closed="InternalFlyout_Closed" />
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="11.5"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SelectedOcrPromptModeLabel, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="8"
                                    Glyph="&#xE70D;"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="3"
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            Width="26"
                            Height="26"
                            Command="{x:Bind ViewModel.RerunOcrCommand}"
                            AutomationProperties.Name="重新执行截图识别"
                            ToolTipService.ToolTip="使用当前 OCR 模式重新识别">
                            <FontIcon
                                FontSize="11"
                                Glyph="&#xE72C;"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <Border
                        Visibility="{x:Bind ViewModel.IsOcrPreviewExpanded, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6"
                        Padding="4"
                        MaxHeight="124">
                        <Image
                            Source="{x:Bind ViewModel.OcrPreviewImage, Mode=OneWay}"
                            MaxHeight="116"
                            Stretch="Uniform"
                            HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sleek 38px Single-Line Collapsed Source Bar (Default on Selection & OCR) -->
            <Border
                Visibility="{x:Bind ViewModel.ShowCollapsedSourceBar, Mode=OneWay}"
                Height="38"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,0"
                Tapped="CollapsedSourcePreview_Tapped"
                ToolTipService.ToolTip="点击展开编辑原文 (Ctrl+I)">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        FontSize="13"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SourceCollapsedPreviewText, Mode=OneWay}" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11.5"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.CharacterCountText, Mode=OneWay}" />
                        <FontIcon
                            FontSize="12"
                            Glyph="&#xE70F;"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Expanded Input / Edit Card (Clean Card + 2px Bottom Focus Accent Border) -->
            <Border
                Visibility="{x:Bind ViewModel.ShowExpandedSourceCard, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBox
                            x:Name="SourceTextBox"
                            Text="{x:Bind ViewModel.SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{x:Bind ViewModel.SourcePlaceholderText, Mode=OneWay}"
                            AutomationProperties.Name="原文输入框"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="64"
                            MaxHeight="148"
                            FontSize="14"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="14,10,14,6"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            GotFocus="SourceTextBox_GotFocus"
                            LostFocus="SourceTextBox_LostFocus"
                            PreviewKeyDown="SourceTextBox_PreviewKeyDown">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>

                        <Grid Padding="14,0,10,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: 字数 · Enter 立即执行 -->
                            <TextBlock
                                Grid.Column="0"
                                FontSize="11.5"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.ExpandedSourceFooterHint, Mode=OneWay}" />

                            <!-- Right: Ghost 🔊 + 清空 + 收起 + Subtle Tonal 执行 ↵ -->
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <Button
                                    Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                                    Width="26"
                                    Height="26"
                                    IsEnabled="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ToggleSpeakSourceCommand}"
                                    AutomationProperties.Name="朗读原文"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SourceSpeakTooltip, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind ViewModel.SourceSpeakGlyph, Mode=OneWay}" />
                                </Button>

                                <Button
                                    Style="{StaticResource PopTranslateContextualLinkButtonStyle}"
                                    Visibility="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ClearSourceCommand}"
                                    AutomationProperties.Name="清空原文"
                                    ToolTipService.ToolTip="清空输入内容">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="清空" />
                                </Button>

                                <Button
                                    Style="{StaticResource PopTranslateContextualLinkButtonStyle}"
                                    Command="{x:Bind ViewModel.ToggleSourceCollapseCommand}"
                                    AutomationProperties.Name="收起原文框"
                                    ToolTipService.ToolTip="收起为单行摘要栏">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="收起" />
                                </Button>

                                <Button
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="5"
                                    IsEnabled="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RetranslateCommand}"
                                    AutomationProperties.Name="立即执行"
                                    ToolTipService.ToolTip="立即执行翻译与润色 (Enter)">
                                    <Border
                                        Background="{ThemeResource PopTranslateAccentSubtleBackgroundBrush}"
                                        BorderBrush="{ThemeResource PopTranslateAccentSubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="8,2">
                                        <TextBlock
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="执行 ↵" />
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 2px Bottom Fluent 2 Focus Accent Border -->
                    <Border
                        x:Name="SourceFocusAccentBorder"
                        VerticalAlignment="Bottom"
                        Height="2"
                        CornerRadius="0,0,8,8"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.85"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Row 2: OCR Progress or Status Banner -->
        <Border
            x:Name="StatusBannerBorder"
            Grid.Row="2"
            Margin="16,0,16,10"
            Visibility="{x:Bind ViewModel.HasStatusBanner, Mode=OneWay}"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8"
            SizeChanged="CardsContentPanel_SizeChanged">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay}" />
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE783;"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Visibility="{x:Bind ViewModel.IsStatusError, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.StatusBannerText, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Row 3: Scrollable Unified Parallel Streaming Service Cards -->
        <ScrollViewer
            x:Name="CardsScrollViewer"
            Grid.Row="3"
            Padding="16,0,16,16"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                x:Name="CardsContentPanel"
                VerticalAlignment="Top"
                Spacing="10"
                SizeChanged="CardsContentPanel_SizeChanged">

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ServiceCards, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServiceCardViewModel">
                            <controls:TranslationResultCardControl ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- No Enabled Providers Hint -->
                <Border
                    Visibility="{x:Bind ViewModel.ShowNoEnabledProvidersHint, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,16">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.NoProvidersHintText, Mode=OneWay}" />
                        <Button
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="前往设置配置服务"
                            Click="NoProvidersSettingsButton_Click">
                            <Border
                                Background="{ThemeResource PopTranslateAccentSubtleBackgroundBrush}"
                                BorderBrush="{ThemeResource PopTranslateAccentSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,5">
                                <TextBlock
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.NoProvidersButtonText, Mode=OneWay}" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Idle Input Hint -->
                <TextBlock
                    Visibility="{x:Bind ViewModel.ShowEmptyHint, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,4"
                    Text="{x:Bind ViewModel.EmptyHintText, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</winex:WindowEx>
