<winex:WindowEx
    x:Class="PopTranslate.App.Windows.TranslationPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    xmlns:controls="using:PopTranslate.App.Controls"
    xmlns:vm="using:PopTranslate.App.ViewModels"
    Title="PopTranslate 翻译"
    Width="440"
    Height="340"
    MinWidth="340"
    MaxWidth="760"
    IsTitleBarVisible="False"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="True">

    <Grid
        x:Name="RootContainer"
        Background="Transparent"
        PreviewKeyDown="RootContainer_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Draggable Top Mode & Utility Bar -->
        <Grid
            x:Name="TopToolbarGrid"
            Grid.Row="0"
            Padding="10,8,8,4"
            Background="Transparent"
            ColumnSpacing="6"
            PointerPressed="TopToolbarGrid_PointerPressed"
            PointerMoved="TopToolbarGrid_PointerMoved"
            PointerReleased="TopToolbarGrid_PointerReleased"
            PointerCaptureLost="TopToolbarGrid_PointerCaptureLost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Drag Grip Indicator -->
            <FontIcon
                Grid.Column="0"
                Glyph="&#xE76F;"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

            <!-- Compact Mode Switch Pill: 翻译 | 润色 (Flicker-Free Segmented Buttons) -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="2"
                VerticalAlignment="Center">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Visibility="{x:Bind ViewModel.IsTranslateMode, Mode=OneWay}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="5"
                        IsHitTestVisible="False" />

                    <Border
                        Grid.Column="1"
                        Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="5"
                        IsHitTestVisible="False" />

                    <Button
                        x:Name="TranslateModeButton"
                        Grid.Column="0"
                        Height="24"
                        MinWidth="48"
                        Padding="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="5"
                        Click="TranslateModeButton_Click"
                        AutomationProperties.Name="翻译模式"
                        ToolTipService.ToolTip="多服务并发翻译模式 (Ctrl+Tab)">
                        <Grid>
                            <TextBlock
                                Visibility="{x:Bind ViewModel.IsTranslateMode, Mode=OneWay}"
                                Text="翻译"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock
                                Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay}"
                                Text="翻译"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="PolishModeButton"
                        Grid.Column="1"
                        Height="24"
                        MinWidth="48"
                        Padding="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="5"
                        Click="PolishModeButton_Click"
                        AutomationProperties.Name="润色模式"
                        ToolTipService.ToolTip="大模型文本润色与本地差异对比模式 (Ctrl+Tab)">
                        <Grid>
                            <TextBlock
                                Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay}"
                                Text="润色"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock
                                Visibility="{x:Bind ViewModel.IsTranslateMode, Mode=OneWay}"
                                Text="润色"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Column 2 (*): Generous Draggable Title Region -->

            <!-- Window Action Micro-Toolbar -->
            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center">
                <ToggleButton
                    Style="{StaticResource PopTranslateMicroToggleButtonStyle}"
                    IsChecked="{x:Bind ViewModel.IsPinned, Mode=TwoWay}"
                    AutomationProperties.Name="置顶锁定弹窗"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PinTooltip, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.PinGlyph, Mode=OneWay}" />
                </ToggleButton>

                <Button
                    Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                    Click="ScreenshotButton_Click"
                    AutomationProperties.Name="截图翻译"
                    ToolTipService.ToolTip="截图翻译">
                    <FontIcon FontSize="12" Glyph="&#xE722;" />
                </Button>

                <Button
                    Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                    Click="SettingsButton_Click"
                    AutomationProperties.Name="打开设置"
                    ToolTipService.ToolTip="打开设置">
                    <FontIcon FontSize="12" Glyph="&#xE713;" />
                </Button>

                <Button
                    x:Name="ClosePopupButton"
                    Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                    Click="ClosePopupButton_Click"
                    AutomationProperties.Name="关闭弹窗"
                    ToolTipService.ToolTip="关闭弹窗 (Esc)">
                    <FontIcon FontSize="11" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Mode-Specific Context Sub-Toolbar -->
        <Grid
            x:Name="SubToolbarContainer"
            Grid.Row="1"
            Padding="10,2,10,6"
            SizeChanged="CardsContentPanel_SizeChanged">

            <!-- Translate Mode Sub-Toolbar: Source/Swap/Target + Merge Line Breaks -->
            <Grid
                Visibility="{x:Bind ViewModel.IsTranslateMode, Mode=OneWay}"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="SourceLangComboBox"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Height="28"
                    MinWidth="86"
                    Padding="8,2,6,2"
                    FontSize="12"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="源语言"
                    DisplayMemberPath="DisplayLabel"
                    ItemsSource="{x:Bind ViewModel.SourceLanguageOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedSourceLanguage, Mode=TwoWay}"
                    DropDownOpened="LanguageComboBox_DropDownOpened"
                    DropDownClosed="LanguageComboBox_DropDownClosed" />

                <Button
                    Grid.Column="1"
                    Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                    Command="{x:Bind ViewModel.SwapLanguagesCommand}"
                    AutomationProperties.Name="互换源语言与目标语言"
                    ToolTipService.ToolTip="互换源语言与目标语言 (Alt+S)">
                    <FontIcon FontSize="12" Glyph="&#xE8AB;" />
                </Button>

                <ComboBox
                    x:Name="TargetLangComboBox"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Height="28"
                    MinWidth="96"
                    Padding="8,2,6,2"
                    FontSize="12"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="目标语言"
                    DisplayMemberPath="DisplayLabel"
                    ItemsSource="{x:Bind ViewModel.TargetLanguageOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTargetLanguage, Mode=TwoWay}"
                    DropDownOpened="LanguageComboBox_DropDownOpened"
                    DropDownClosed="LanguageComboBox_DropDownClosed" />

                <ToggleButton
                    Grid.Column="3"
                    Style="{StaticResource PopTranslateMicroToggleButtonStyle}"
                    IsChecked="{x:Bind ViewModel.MergeLineBreaks, Mode=TwoWay}"
                    AutomationProperties.Name="智能合并换行"
                    ToolTipService.ToolTip="智能合并 PDF / OCR 换行">
                    <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                </ToggleButton>
            </Grid>

            <!-- Polish Mode Sub-Toolbar: Style Preset Selector + Inline Custom Prompt -->
            <StackPanel
                Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay}"
                Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="12"
                            Glyph="&#xE70F;"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="润色风格"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <ComboBox
                        x:Name="PolishStyleComboBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Height="28"
                        Padding="8,2,6,2"
                        FontSize="12"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="润色风格"
                        DisplayMemberPath="DisplayLabel"
                        ItemsSource="{x:Bind ViewModel.PolishStyleOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedPolishStyle, Mode=TwoWay}"
                        DropDownOpened="LanguageComboBox_DropDownOpened"
                        DropDownClosed="LanguageComboBox_DropDownClosed" />
                </Grid>

                <!-- Inline Custom Prompt Field (Shown Only When Custom Style Is Selected) -->
                <TextBox
                    x:Name="CustomPolishPromptTextBox"
                    Visibility="{x:Bind ViewModel.IsCustomPolishStyleSelected, Mode=OneWay}"
                    Text="{x:Bind ViewModel.InlineCustomPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="输入自定义润色 Prompt（按 Enter 立即润色，留空使用默认 Prompt）"
                    AutomationProperties.Name="自定义润色提示词"
                    FontSize="12"
                    AcceptsReturn="False"
                    TextWrapping="Wrap"
                    MaxHeight="68"
                    Padding="8,5"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    PreviewKeyDown="CustomPolishPromptTextBox_PreviewKeyDown" />
            </StackPanel>
        </Grid>

        <!-- Row 2: Editable & Collapsible Source Text Card (+ OCR Preview & Prompt Mode Bar) -->
        <Border
            x:Name="SourceCardBorder"
            Grid.Row="2"
            Margin="10,2,10,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,8,10,6"
            SizeChanged="CardsContentPanel_SizeChanged">
            <StackPanel Spacing="6">
                <!-- OCR Flow Context Bar & Collapsible Screenshot Thumbnail -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.HasOcrContext, Mode=OneWay}"
                    Spacing="6">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Style="{StaticResource PopTranslateMicroChipButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleOcrPreviewCommand}"
                            AutomationProperties.Name="查看或收起截图预览"
                            ToolTipService.ToolTip="展开或收起原始截图缩略图">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon FontSize="11" Glyph="&#xEB9F;" />
                                <TextBlock FontSize="11" Text="{x:Bind ViewModel.OcrPreviewToggleLabel, Mode=OneWay}" VerticalAlignment="Center" />
                                <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.OcrPreviewChevronGlyph, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <ComboBox
                            x:Name="OcrPromptModeComboBox"
                            Grid.Column="2"
                            Height="26"
                            MinWidth="118"
                            Padding="8,2,6,2"
                            FontSize="11"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="OCR 识别模式"
                            DisplayMemberPath="DisplayLabel"
                            ItemsSource="{x:Bind ViewModel.OcrPromptModeOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedOcrPromptMode, Mode=TwoWay}"
                            DropDownOpened="LanguageComboBox_DropDownOpened"
                            DropDownClosed="LanguageComboBox_DropDownClosed" />

                        <Button
                            Grid.Column="3"
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            Width="26"
                            Height="26"
                            Command="{x:Bind ViewModel.RerunOcrCommand}"
                            AutomationProperties.Name="重新执行截图识别"
                            ToolTipService.ToolTip="使用当前 OCR 模式重新识别">
                            <FontIcon FontSize="11" Glyph="&#xE72C;" />
                        </Button>
                    </Grid>

                    <Border
                        Visibility="{x:Bind ViewModel.IsOcrPreviewExpanded, Mode=OneWay}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="4"
                        MaxHeight="124">
                        <Image
                            Source="{x:Bind ViewModel.OcrPreviewImage, Mode=OneWay}"
                            MaxHeight="116"
                            Stretch="Uniform"
                            HorizontalAlignment="Center" />
                    </Border>

                    <Border
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>

                <!-- Expanded Editable Source Box -->
                <TextBox
                    x:Name="SourceTextBox"
                    Visibility="{x:Bind ViewModel.IsSourceCardExpanded, Mode=OneWay}"
                    Text="{x:Bind ViewModel.SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{x:Bind ViewModel.SourcePlaceholderText, Mode=OneWay}"
                    AutomationProperties.Name="原文输入框"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="56"
                    MaxHeight="140"
                    FontSize="14"
                    BorderThickness="0"
                    Background="Transparent"
                    Padding="2,2,2,2"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    PreviewKeyDown="SourceTextBox_PreviewKeyDown" />

                <!-- Collapsed 1-Line Source Preview (Tap to Expand & Edit) -->
                <Border
                    Visibility="{x:Bind ViewModel.IsSourceCardCollapsed, Mode=OneWay}"
                    Background="Transparent"
                    Padding="2,2"
                    Tapped="CollapsedSourcePreview_Tapped"
                    ToolTipService.ToolTip="点击展开编辑原文 (Ctrl+I)">
                    <TextBlock
                        FontSize="13"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SourceCollapsedPreviewText, Mode=OneWay}" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Detected Language / Polish Style Pill + Char Count -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border
                            Visibility="{x:Bind ViewModel.HasDetectedBadge, Mode=OneWay}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="6,2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DetectedLanguageBadge, Mode=OneWay}" />
                        </Border>

                        <TextBlock
                            FontSize="11"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.CharacterCountText, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Source Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Button
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleSpeakSourceCommand}"
                            AutomationProperties.Name="朗读原文"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SourceSpeakTooltip, Mode=OneWay}">
                            <FontIcon FontSize="11" Glyph="{x:Bind ViewModel.SourceSpeakGlyph, Mode=OneWay}" />
                        </Button>

                        <Button
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            Visibility="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ClearSourceCommand}"
                            AutomationProperties.Name="清空原文"
                            ToolTipService.ToolTip="清空原文">
                            <FontIcon FontSize="11" Glyph="&#xE711;" />
                        </Button>

                        <Button
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CopySourceCommand}"
                            AutomationProperties.Name="复制原文"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SourceCopyTooltip, Mode=OneWay}">
                            <FontIcon FontSize="11" Glyph="{x:Bind ViewModel.SourceCopyGlyph, Mode=OneWay}" />
                        </Button>

                        <Button
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleSourceCollapseCommand}"
                            AutomationProperties.Name="折叠或展开原文"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SourceCollapseTooltip, Mode=OneWay}">
                            <FontIcon FontSize="10" Glyph="{x:Bind ViewModel.SourceCollapseGlyph, Mode=OneWay}" />
                        </Button>

                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsSourceCardExpanded, Mode=OneWay}"
                            Padding="10,3"
                            FontSize="12"
                            Height="26"
                            Content="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                            AutomationProperties.Name="立即执行翻译或润色"
                            Command="{x:Bind ViewModel.RetranslateCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 3: OCR Progress or Status Banner -->
        <Border
            x:Name="StatusBannerBorder"
            Grid.Row="3"
            Margin="10,0,10,8"
            Visibility="{x:Bind ViewModel.HasStatusBanner, Mode=OneWay}"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8"
            SizeChanged="CardsContentPanel_SizeChanged">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay}" />
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE783;"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Visibility="{x:Bind ViewModel.IsStatusError, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.StatusBannerText, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Row 4: Scrollable Parallel Streaming Service Cards -->
        <ScrollViewer
            x:Name="CardsScrollViewer"
            Grid.Row="4"
            Padding="10,0,10,10"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                x:Name="CardsContentPanel"
                VerticalAlignment="Top"
                Spacing="8"
                SizeChanged="CardsContentPanel_SizeChanged">

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ServiceCards, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServiceCardViewModel">
                            <controls:TranslationResultCardControl ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- No Enabled / Eligible Providers Hint -->
                <Border
                    Visibility="{x:Bind ViewModel.ShowNoEnabledProvidersHint, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon
                            FontSize="20"
                            Glyph="&#xE945;"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay}" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.NoProvidersHintText, Mode=OneWay}" />
                        <TextBlock
                            Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Text="请在「翻译服务」中启用并配置至少一个 OpenAI 兼容大模型（如 OpenAI、DeepSeek、Ollama 等）后即可使用润色。" />
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{x:Bind ViewModel.NoProvidersButtonText, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            Margin="0,2,0,0"
                            AutomationProperties.Name="前往设置配置服务"
                            Click="NoProvidersSettingsButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Idle Input Hint -->
                <TextBlock
                    Visibility="{x:Bind ViewModel.ShowEmptyHint, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,6"
                    Text="{x:Bind ViewModel.EmptyHintText, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</winex:WindowEx>
