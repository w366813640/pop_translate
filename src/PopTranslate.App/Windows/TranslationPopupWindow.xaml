<winex:WindowEx
    x:Class="PopTranslate.App.Windows.TranslationPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    xmlns:controls="using:PopTranslate.App.Controls"
    xmlns:vm="using:PopTranslate.App.ViewModels"
    Title="PopTranslate 翻译"
    Width="440"
    Height="340"
    MinWidth="340"
    MaxWidth="760"
    IsTitleBarVisible="False"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="True">

    <Grid
        x:Name="RootContainer"
        Background="Transparent"
        PreviewKeyDown="RootContainer_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Draggable Top Mode & Utility Bar -->
        <Grid
            x:Name="TopToolbarGrid"
            Grid.Row="0"
            Padding="10,8,8,4"
            Background="Transparent"
            ColumnSpacing="6"
            PointerPressed="TopToolbarGrid_PointerPressed"
            PointerMoved="TopToolbarGrid_PointerMoved"
            PointerReleased="TopToolbarGrid_PointerReleased"
            PointerCaptureLost="TopToolbarGrid_PointerCaptureLost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Drag Grip Indicator -->
            <FontIcon
                Grid.Column="0"
                Glyph="&#xE76F;"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

            <!-- Compact Mode Switch Pill: 翻译 | 润色 -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="2"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton
                        x:Name="TranslateModeButton"
                        Style="{StaticResource PopTranslateModePillToggleButtonStyle}"
                        Content="翻译"
                        Click="TranslateModeButton_Click"
                        ToolTipService.ToolTip="多服务并发翻译模式" />
                    <ToggleButton
                        x:Name="PolishModeButton"
                        Style="{StaticResource PopTranslateModePillToggleButtonStyle}"
                        Content="润色"
                        Click="PolishModeButton_Click"
                        ToolTipService.ToolTip="大模型文本润色与本地差异对比模式" />
                </StackPanel>
            </Border>

            <!-- Column 2 (*): Generous Draggable Title Region -->

            <!-- Window Action Micro-Toolbar -->
            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center">
                <ToggleButton
                    Style="{StaticResource PopTranslateMicroToggleButtonStyle}"
                    IsChecked="{x:Bind ViewModel.IsPinned, Mode=TwoWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PinTooltip, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.PinGlyph, Mode=OneWay}" />
                </ToggleButton>

                <Button
                    Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                    Click="ScreenshotButton_Click"
                    ToolTipService.ToolTip="截图翻译">
                    <FontIcon FontSize="12" Glyph="&#xE722;" />
                </Button>

                <Button
                    Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="打开设置">
                    <FontIcon FontSize="12" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Mode-Specific Context Sub-Toolbar -->
        <Grid
            x:Name="SubToolbarContainer"
            Grid.Row="1"
            Padding="10,2,10,6"
            SizeChanged="CardsContentPanel_SizeChanged">

            <!-- Translate Mode Sub-Toolbar: Source/Swap/Target + Merge Line Breaks -->
            <Grid
                Visibility="{x:Bind ViewModel.IsTranslateMode, Mode=OneWay}"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="SourceLangComboBox"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Height="28"
                    MinWidth="86"
                    Padding="8,2,6,2"
                    FontSize="12"
                    VerticalAlignment="Center"
                    DisplayMemberPath="DisplayLabel"
                    ItemsSource="{x:Bind ViewModel.SourceLanguageOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedSourceLanguage, Mode=TwoWay}"
                    DropDownOpened="LanguageComboBox_DropDownOpened"
                    DropDownClosed="LanguageComboBox_DropDownClosed" />

                <Button
                    Grid.Column="1"
                    Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                    Command="{x:Bind ViewModel.SwapLanguagesCommand}"
                    ToolTipService.ToolTip="互换源语言与目标语言">
                    <FontIcon FontSize="12" Glyph="&#xE8AB;" />
                </Button>

                <ComboBox
                    x:Name="TargetLangComboBox"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Height="28"
                    MinWidth="96"
                    Padding="8,2,6,2"
                    FontSize="12"
                    VerticalAlignment="Center"
                    DisplayMemberPath="DisplayLabel"
                    ItemsSource="{x:Bind ViewModel.TargetLanguageOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTargetLanguage, Mode=TwoWay}"
                    DropDownOpened="LanguageComboBox_DropDownOpened"
                    DropDownClosed="LanguageComboBox_DropDownClosed" />

                <ToggleButton
                    Grid.Column="3"
                    Style="{StaticResource PopTranslateMicroToggleButtonStyle}"
                    IsChecked="{x:Bind ViewModel.MergeLineBreaks, Mode=TwoWay}"
                    ToolTipService.ToolTip="智能合并 PDF / OCR 换行">
                    <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                </ToggleButton>
            </Grid>

            <!-- Polish Mode Sub-Toolbar: Style Preset Selector + Inline Custom Prompt -->
            <StackPanel
                Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay}"
                Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="12"
                            Glyph="&#xE70F;"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="润色风格"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <ComboBox
                        x:Name="PolishStyleComboBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Height="28"
                        Padding="8,2,6,2"
                        FontSize="12"
                        VerticalAlignment="Center"
                        DisplayMemberPath="DisplayLabel"
                        ItemsSource="{x:Bind ViewModel.PolishStyleOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedPolishStyle, Mode=TwoWay}"
                        DropDownOpened="LanguageComboBox_DropDownOpened"
                        DropDownClosed="LanguageComboBox_DropDownClosed" />
                </Grid>

                <!-- Inline Custom Prompt Field (Shown Only When Custom Style Is Selected) -->
                <TextBox
                    x:Name="CustomPolishPromptTextBox"
                    Visibility="{x:Bind ViewModel.IsCustomPolishStyleSelected, Mode=OneWay}"
                    Text="{x:Bind ViewModel.InlineCustomPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="输入自定义润色 Prompt（按 Enter 立即润色，留空使用默认 Prompt）"
                    FontSize="12"
                    AcceptsReturn="False"
                    TextWrapping="Wrap"
                    MaxHeight="68"
                    Padding="8,5"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    PreviewKeyDown="CustomPolishPromptTextBox_PreviewKeyDown" />
            </StackPanel>
        </Grid>

        <!-- Row 2: Editable Source Text Card -->
        <Border
            x:Name="SourceCardBorder"
            Grid.Row="2"
            Margin="10,2,10,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,8,10,6"
            SizeChanged="CardsContentPanel_SizeChanged">
            <StackPanel Spacing="6">
                <TextBox
                    x:Name="SourceTextBox"
                    Text="{x:Bind ViewModel.SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{x:Bind ViewModel.SourcePlaceholderText, Mode=OneWay}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="56"
                    MaxHeight="140"
                    FontSize="14"
                    BorderThickness="0"
                    Background="Transparent"
                    Padding="2,2,2,2"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    PreviewKeyDown="SourceTextBox_PreviewKeyDown" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Detected Language / Polish Style Pill + Char Count -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border
                            Visibility="{x:Bind ViewModel.HasDetectedBadge, Mode=OneWay}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="6,2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DetectedLanguageBadge, Mode=OneWay}" />
                        </Border>

                        <TextBlock
                            FontSize="11"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.CharacterCountText, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Source Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            Visibility="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ClearSourceCommand}"
                            ToolTipService.ToolTip="清空原文">
                            <FontIcon FontSize="11" Glyph="&#xE711;" />
                        </Button>

                        <Button
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CopySourceCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SourceCopyTooltip, Mode=OneWay}">
                            <FontIcon FontSize="11" Glyph="{x:Bind ViewModel.SourceCopyGlyph, Mode=OneWay}" />
                        </Button>

                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="10,3"
                            FontSize="12"
                            Height="26"
                            Content="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasSourceText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.RetranslateCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 3: OCR Progress or Status Banner -->
        <Border
            x:Name="StatusBannerBorder"
            Grid.Row="3"
            Margin="10,0,10,8"
            Visibility="{x:Bind ViewModel.HasStatusBanner, Mode=OneWay}"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8"
            SizeChanged="CardsContentPanel_SizeChanged">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay}" />
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE783;"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Visibility="{x:Bind ViewModel.IsStatusError, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.StatusBannerText, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Row 4: Scrollable Parallel Streaming Service Cards -->
        <ScrollViewer
            x:Name="CardsScrollViewer"
            Grid.Row="4"
            Padding="10,0,10,10"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                x:Name="CardsContentPanel"
                VerticalAlignment="Top"
                Spacing="8"
                SizeChanged="CardsContentPanel_SizeChanged">

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ServiceCards, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServiceCardViewModel">
                            <controls:TranslationResultCardControl ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- No Enabled / Eligible Providers Hint -->
                <Border
                    Visibility="{x:Bind ViewModel.ShowNoEnabledProvidersHint, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon
                            FontSize="20"
                            Glyph="&#xE945;"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay}" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.NoProvidersHintText, Mode=OneWay}" />
                        <TextBlock
                            Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Text="请在「翻译服务」中启用并配置至少一个 OpenAI 兼容大模型（如 OpenAI、DeepSeek、Ollama 等）后即可使用润色。" />
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{x:Bind ViewModel.NoProvidersButtonText, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            Margin="0,2,0,0"
                            Click="NoProvidersSettingsButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Idle Input Hint -->
                <TextBlock
                    Visibility="{x:Bind ViewModel.ShowEmptyHint, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,6"
                    Text="{x:Bind ViewModel.EmptyHintText, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</winex:WindowEx>
