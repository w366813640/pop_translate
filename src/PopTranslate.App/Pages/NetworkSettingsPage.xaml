<Page
    x:Class="PopTranslate.App.Pages.NetworkSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="网络与权限" Style="{StaticResource SubtitleTextBlockStyle}" />

            <!-- Proxy Configuration Card -->
            <TextBlock Text="网络代理" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
            <Border Style="{StaticResource PopTranslateSettingsCardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="代理模式" FontWeight="SemiBold" />
                            <TextBlock
                                Text="默认遵循 Windows 系统代理，支持切换直连或自定义 HTTP / SOCKS5 代理（立即应用于所有翻译与视觉 OCR 请求）"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="220"
                            SelectedIndex="{x:Bind ViewModel.ProxyModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="跟随 Windows 系统代理" />
                            <ComboBoxItem Content="不使用代理（直连）" />
                            <ComboBoxItem Content="HTTP 代理" />
                            <ComboBoxItem Content="SOCKS5 代理" />
                        </ComboBox>
                    </Grid>

                    <!-- Custom HTTP / SOCKS5 Fields -->
                    <StackPanel
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsCustomProxyMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Header="代理主机 (Host)"
                                PlaceholderText="127.0.0.1"
                                Text="{x:Bind ViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <NumberBox
                                Grid.Column="1"
                                Header="端口 (Port)"
                                Minimum="1"
                                Maximum="65535"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Header="用户名（可选）"
                                PlaceholderText="留空表示无需认证"
                                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <PasswordBox
                                Grid.Column="1"
                                Header="密码（可选，DPAPI 加密保存）"
                                PlaceholderText="代理认证密码"
                                Password="{x:Bind ViewModel.PasswordPlaintext, Mode=TwoWay}" />
                        </Grid>

                        <ToggleSwitch
                            Header="对本地地址跳过代理 (Bypass Local)"
                            OnContent="跳过本地地址"
                            OffContent="全部走代理"
                            IsOn="{x:Bind ViewModel.BypassLocalAddresses, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Content="保存代理设置"
                            Command="{x:Bind ViewModel.SaveProxySettingsCommand}" />
                    </StackPanel>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasProxyFeedback, Mode=OneWay}"
                        IsClosable="False"
                        Severity="{x:Bind ViewModel.ProxyFeedbackSeverity, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ProxyFeedbackMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Privilege & UAC-Free Elevated Auto-Start Card -->
            <TextBlock Text="运行权限与提权自启" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource PopTranslateSettingsCardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="当前运行权限：" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind ViewModel.PrivilegeStatusLabel, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.PrivilegeStatusDescription, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.CanRestartAsAdministrator, Mode=OneWay}"
                            Command="{x:Bind ViewModel.RestartAsAdministratorCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE7EF;" />
                                <TextBlock Text="以管理员身份重启" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="通过任务计划免 UAC 提权开机自启" FontWeight="SemiBold" />
                            <TextBlock
                                Text="在 Windows 任务计划程序中注册高权限登录任务，开机自动以管理员权限常驻托盘且不弹出 UAC 确认框（首次开启需处于管理员权限状态）"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="开启"
                            OffContent="关闭"
                            IsOn="{x:Bind ViewModel.IsElevatedStartupTaskEnabled, Mode=TwoWay}" />
                    </Grid>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasPrivilegeFeedback, Mode=OneWay}"
                        IsClosable="False"
                        Severity="{x:Bind ViewModel.PrivilegeFeedbackSeverity, Mode=OneWay}"
                        Message="{x:Bind ViewModel.PrivilegeFeedbackMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Diagnostics & Logs Card -->
            <TextBlock Text="诊断与运行日志" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource PopTranslateSettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="本地运行诊断日志" FontWeight="SemiBold" />
                        <TextBlock
                            Text="查看本地脱敏诊断日志（绝不记录用户划词文本或 API Key），支持便携模式 ./data/logs 与标准模式目录"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="打开运行日志目录"
                        Command="{x:Bind ViewModel.OpenLogsDirectoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                            <TextBlock Text="打开运行日志目录" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
