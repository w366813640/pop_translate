<Page
    x:Class="PopTranslate.App.Pages.ProvidersSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PopTranslate.App.ViewModels">

    <Grid Padding="28,20,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="翻译服务" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="支持同时启用多个服务并发翻译，可添加多个 OpenAI 兼容大模型实例（如 DeepSeek、OpenAI、Ollama、OneAPI 等）。API Key 均经由 Windows DPAPI 加密存储。"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Action Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button
                Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.Name="添加大模型服务预设">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="添加大模型服务" />
                    <FontIcon FontSize="10" Glyph="&#xE70D;" Opacity="0.85" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem Text="OpenAI (gpt-4o-mini)" Tag="openai" Click="AddLlmPreset_Click" />
                        <MenuFlyoutItem Text="DeepSeek (deepseek-chat)" Tag="deepseek" Click="AddLlmPreset_Click" />
                        <MenuFlyoutItem Text="Google Gemini (gemini-2.5-flash)" Tag="gemini" Click="AddLlmPreset_Click" />
                        <MenuFlyoutItem Text="SiliconFlow (硅基流动)" Tag="siliconflow" Click="AddLlmPreset_Click" />
                        <MenuFlyoutItem Text="Ollama (本地免密钥)" Tag="ollama" Click="AddLlmPreset_Click" />
                        <MenuFlyoutItem Text="OpenRouter" Tag="openrouter" Click="AddLlmPreset_Click" />
                        <MenuFlyoutItem Text="通义千问 (DashScope)" Tag="dashscope" Click="AddLlmPreset_Click" />
                        <MenuFlyoutItem Text="智谱 GLM (glm-4-flash)" Tag="zhipu" Click="AddLlmPreset_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="自定义 OpenAI 兼容实例" Tag="custom" Click="AddLlmPreset_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button Command="{x:Bind ViewModel.AddDeepLProviderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="添加 DeepL" />
                </StackPanel>
            </Button>

            <Button Command="{x:Bind ViewModel.AddFreeTraditionalProviderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="添加免费翻译" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Master-Detail Layout -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Provider Cards List & Ordering -->
            <Border Grid.Column="0" Style="{StaticResource PopTranslateSettingsCardStyle}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView
                        Grid.Row="0"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderItemViewModel">
                                <Grid Padding="4,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="5,1">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind BadgeText}" />
                                            </Border>
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Text="{x:Bind DisplayName, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind KindLabel}" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        Grid.Column="1"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        VerticalAlignment="Center"
                                        IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Reorder / Delete Bar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button
                            AutomationProperties.Name="上移卡片顺序"
                            ToolTipService.ToolTip="上移卡片顺序"
                            IsEnabled="{x:Bind ViewModel.HasSelectedProvider, Mode=OneWay}"
                            Command="{x:Bind ViewModel.MoveSelectedUpCommand}">
                            <FontIcon FontSize="12" Glyph="&#xE74A;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="下移卡片顺序"
                            ToolTipService.ToolTip="下移卡片顺序"
                            IsEnabled="{x:Bind ViewModel.HasSelectedProvider, Mode=OneWay}"
                            Command="{x:Bind ViewModel.MoveSelectedDownCommand}">
                            <FontIcon FontSize="12" Glyph="&#xE74B;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="删除所选实例"
                            ToolTipService.ToolTip="删除所选实例"
                            IsEnabled="{x:Bind ViewModel.HasSelectedProvider, Mode=OneWay}">
                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                            <Button.Flyout>
                                <Flyout x:Name="DeleteConfirmFlyout" Placement="Top">
                                    <StackPanel Spacing="10" MaxWidth="240">
                                        <TextBlock
                                            Text="确定要删除所选翻译服务实例吗？其已保存的 API Key 与自定义配置将一并移除。"
                                            TextWrapping="Wrap"
                                            FontSize="12" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button
                                                Content="取消"
                                                Click="CancelDeleteProvider_Click" />
                                            <Button
                                                Style="{StaticResource AccentButtonStyle}"
                                                Content="确认删除"
                                                Click="ConfirmDeleteProvider_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Column: Selected Provider Editor -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border
                        Style="{StaticResource PopTranslateSettingsCardStyle}"
                        Visibility="{x:Bind ViewModel.HasSelectedProvider, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.SelectedProvider.DisplayName, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SelectedProvider.KindLabel, Mode=OneWay}" />
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    OnContent="已启用"
                                    OffContent="已停用"
                                    IsOn="{x:Bind ViewModel.SelectedProvider.Enabled, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Common Fields -->
                            <TextBox
                                Header="显示名称"
                                PlaceholderText="例如：DeepSeek 翻译 / GPT-4o mini"
                                Text="{x:Bind ViewModel.SelectedProvider.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- OpenAI-Compatible Specific Settings -->
                            <StackPanel
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.SelectedProvider.IsOpenAi, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBox
                                    Header="API Base URL"
                                    PlaceholderText="https://api.openai.com/v1"
                                    Text="{x:Bind ViewModel.SelectedProvider.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="124" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Header="模型名称 (Model)"
                                        PlaceholderText="gpt-4o-mini / deepseek-chat / qwen2.5"
                                        Text="{x:Bind ViewModel.SelectedProvider.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        ToolTipService.ToolTip="从当前 API Base URL 拉取可用模型列表"
                                        IsEnabled="{x:Bind ViewModel.CanFetchModels, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.FetchModelsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                            <TextBlock Text="拉取模型" />
                                        </StackPanel>
                                    </Button>
                                    <NumberBox
                                        Grid.Column="2"
                                        Header="Temperature"
                                        Minimum="0"
                                        Maximum="2"
                                        SmallChange="0.1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.SelectedProvider.Temperature, Mode=TwoWay}" />
                                </Grid>

                                <ComboBox
                                    Header="已拉取的可用模型（点击快速填入）"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="从已拉取模型列表中选择..."
                                    Visibility="{x:Bind ViewModel.HasDiscoveredModels, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ItemsSource="{x:Bind ViewModel.DiscoveredModels, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedDiscoveredModel, Mode=TwoWay}" />

                                <PasswordBox
                                    Header="API Key（Windows DPAPI 本地加密保存）"
                                    PlaceholderText="sk-..."
                                    Password="{x:Bind ViewModel.SelectedProvider.ApiKeyPlaintext, Mode=TwoWay}" />

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="系统提示词 (System Prompt)" VerticalAlignment="Center" />
                                        <Button
                                            Content="恢复默认"
                                            HorizontalAlignment="Right"
                                            Padding="8,2"
                                            FontSize="12"
                                            Command="{x:Bind ViewModel.ResetSystemPromptCommand}" />
                                    </Grid>
                                    <TextBox
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="84"
                                        MaxHeight="150"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        PlaceholderText="支持 {source} 与 {target} 占位符"
                                        Text="{x:Bind ViewModel.SelectedProvider.SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Text="提示：可使用 {source} 和 {target} 占位符自动注入检测到的源语言和目标语言。"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- DeepL Specific Settings -->
                            <StackPanel
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.SelectedProvider.IsDeepL, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <PasswordBox
                                    Header="DeepL API Key（Windows DPAPI 本地加密保存）"
                                    PlaceholderText="输入 Free (:fx) 或 Pro Auth Key"
                                    Password="{x:Bind ViewModel.SelectedProvider.ApiKeyPlaintext, Mode=TwoWay}" />

                                <ComboBox
                                    Header="端点类型"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="{x:Bind ViewModel.SelectedProvider.DeepLTierIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="自动识别（以 :fx 结尾自动走 Free API）" />
                                    <ComboBoxItem Content="DeepL Free API (api-free.deepl.com)" />
                                    <ComboBoxItem Content="DeepL Pro API (api.deepl.com)" />
                                </ComboBox>

                                <TextBox
                                    Header="自定义网关地址（可选，留空使用官方地址）"
                                    PlaceholderText="https://api-free.deepl.com/v2/translate"
                                    Text="{x:Bind ViewModel.SelectedProvider.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Free Traditional Specific Settings -->
                            <StackPanel
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.SelectedProvider.IsFreeTraditional, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ComboBox
                                    Header="免费引擎策略"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="{x:Bind ViewModel.SelectedProvider.FreeEngineIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="自动（优先 Google，失败自动回退 Bing）" />
                                    <ComboBoxItem Content="仅使用 Google 免费翻译" />
                                    <ComboBoxItem Content="仅使用 Bing 免费翻译" />
                                </ComboBox>
                                <TextBox
                                    Header="自定义 Google 镜像地址（可选，留空自动使用官方多节点）"
                                    PlaceholderText="https://clients5.google.com"
                                    Text="{x:Bind ViewModel.SelectedProvider.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Text="开箱即用，无需配置 API Key。Google 引擎内置多节点自动故障转移，若所处网络环境无法直连，可配置自定义镜像或在「网络与权限」中配置系统/HTTP/SOCKS5 代理。"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Card Behavior & Timeout -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <ToggleSwitch
                                    Grid.Column="0"
                                    Header="弹窗内默认折叠此卡片"
                                    OnContent="默认折叠"
                                    OffContent="默认展开"
                                    IsOn="{x:Bind ViewModel.SelectedProvider.IsCollapsedByDefault, Mode=TwoWay}" />

                                <NumberBox
                                    Grid.Column="1"
                                    Header="超时时间（秒）"
                                    Minimum="5"
                                    Maximum="180"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.SelectedProvider.TimeoutSeconds, Mode=TwoWay}" />
                            </Grid>

                            <!-- Save / Test Bar -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="保存配置"
                                    Command="{x:Bind ViewModel.SaveSelectedProviderCommand}" />

                                <Button
                                    Command="{x:Bind ViewModel.TestSelectedProviderCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanTestConnection, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                                        <TextBlock Text="测试连接" />
                                    </StackPanel>
                                </Button>

                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.IsTestingConnection, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsTestingConnection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Empty State when no provider is selected -->
                    <Border
                        Style="{StaticResource PopTranslateSettingsCardStyle}"
                        Visibility="{x:Bind ViewModel.HasNoSelectedProvider, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="6" Padding="12,24" HorizontalAlignment="Center">
                            <FontIcon FontSize="28" Glyph="&#xE8C1;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="请选择左侧服务实例，或点击上方按钮添加新的翻译服务"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Feedback Banner -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasFeedback, Mode=OneWay}"
                        IsClosable="False"
                        Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}"
                        Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
