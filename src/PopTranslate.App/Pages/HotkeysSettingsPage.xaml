<Page
    x:Class="PopTranslate.App.Pages.HotkeysSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PopTranslate.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="划词与快捷键" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="点击快捷键录制框后按下组合键即可生效；若快捷键已被其他应用占用，将即时提示冲突。"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Global Hotkeys Card -->
            <Grid Margin="0,4,0,0">
                <TextBlock Text="全局快捷键" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button
                    Content="恢复默认快捷键"
                    HorizontalAlignment="Right"
                    Padding="10,4"
                    FontSize="12"
                    Command="{x:Bind ViewModel.ResetDefaultHotkeysCommand}" />
            </Grid>
            <Border Style="{StaticResource PopTranslateSettingsCardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="划词翻译快捷键" FontWeight="SemiBold" />
                            <TextBlock
                                Text="读取当前选中文本并弹出并发翻译卡片（优先 UIA 无侵扰读取）"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:HotkeyRecorderBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Gesture="{x:Bind ViewModel.SelectionTranslateGesture, Mode=OneWay}"
                            ErrorMessage="{x:Bind ViewModel.SelectionHotkeyError, Mode=OneWay}"
                            GestureChanged="SelectionHotkey_GestureChanged" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="输入翻译快捷键" FontWeight="SemiBold" />
                            <TextBlock
                                Text="呼出翻译弹窗并自动聚焦输入框，支持直接键入或粘贴翻译"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:HotkeyRecorderBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Gesture="{x:Bind ViewModel.InputTranslateGesture, Mode=OneWay}"
                            ErrorMessage="{x:Bind ViewModel.InputHotkeyError, Mode=OneWay}"
                            GestureChanged="InputHotkey_GestureChanged" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="截图翻译快捷键" FontWeight="SemiBold" />
                            <TextBlock
                                Text="冻结多显示器画面，拖拽选区松开鼠标即刻执行 OCR 并翻译"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:HotkeyRecorderBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Gesture="{x:Bind ViewModel.ScreenshotTranslateGesture, Mode=OneWay}"
                            ErrorMessage="{x:Bind ViewModel.ScreenshotHotkeyError, Mode=OneWay}"
                            GestureChanged="ScreenshotHotkey_GestureChanged" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="划词润色快捷键" FontWeight="SemiBold" />
                            <TextBlock
                                Text="读取当前选中文本并直接以润色模式弹出大模型并发流式润色（默认 Alt + P）"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:HotkeyRecorderBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Gesture="{x:Bind ViewModel.SelectionPolishGesture, Mode=OneWay}"
                            ErrorMessage="{x:Bind ViewModel.SelectionPolishHotkeyError, Mode=OneWay}"
                            GestureChanged="SelectionPolishHotkey_GestureChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hover Selection & Safety Strategy -->
            <TextBlock Text="划词悬浮图标与防打扰策略" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource PopTranslateSettingsCardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="启用划词悬浮图标" FontWeight="SemiBold" />
                            <TextBlock
                                Text="鼠标拖选或双击选中文字后，在指针旁零焦点抢占弹出小图标（拖选过程绝不自动发送 Ctrl+C）"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="开启"
                            OffContent="关闭"
                            IsOn="{x:Bind ViewModel.EnableHoverIcon, Mode=TwoWay}" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="允许防污染剪贴板回退" FontWeight="SemiBold" />
                            <TextBlock
                                Text="仅在主动按下划词快捷键或点击悬浮图标且 UIA 无法读取时，安全备份剪贴板 → 模拟复制 → 立即恢复并排除历史记录污染"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="开启"
                            OffContent="关闭"
                            IsOn="{x:Bind ViewModel.EnableClipboardFallback, Mode=TwoWay}" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="全屏应用免打扰模式" FontWeight="SemiBold" />
                            <TextBlock
                                Text="检测到全屏游戏、全屏视频或演示模式时自动抑制划词悬浮图标"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="开启"
                            OffContent="关闭"
                            IsOn="{x:Bind ViewModel.QuietModeInFullscreen, Mode=TwoWay}" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            Grid.Column="0"
                            Header="悬浮图标自动隐藏（ms）"
                            Minimum="1500"
                            Maximum="15000"
                            SmallChange="500"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.HoverIconAutoDismissMs, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="1"
                            Header="最小拖选距离（px）"
                            Minimum="4"
                            Maximum="80"
                            SmallChange="2"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.MinDragDistancePixels, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="2"
                            Header="剪贴板等待超时（ms）"
                            Minimum="100"
                            Maximum="1000"
                            SmallChange="50"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.ClipboardWaitTimeoutMs, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Process Blacklist Card -->
            <TextBlock Text="划词忽略进程黑名单" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource PopTranslateSettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="在以下进程窗口内（如终端、远程桌面、全屏游戏）不会弹出划词悬浮图标，避免误触或发送 Ctrl+C 终止终端进程。"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="输入进程名，如 WindowsTerminal.exe 或 cmd"
                            Text="{x:Bind ViewModel.NewBlacklistProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="BlacklistInputBox_KeyDown" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="添加进程"
                            Command="{x:Bind ViewModel.AddBlacklistProcessCommand}" />
                        <Button
                            Grid.Column="2"
                            Content="恢复默认黑名单"
                            Command="{x:Bind ViewModel.ResetDefaultBlacklistCommand}" />
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ProcessBlacklist, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="210"
                                MinItemHeight="34"
                                MinRowSpacing="6"
                                MinColumnSpacing="8"
                                ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4,4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{x:Bind}" />
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="移除"
                                            Click="RemoveBlacklistItem_Click">
                                            <FontIcon FontSize="10" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <TextBlock
                Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
