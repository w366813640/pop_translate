<Page
    x:Class="PopTranslate.App.Pages.OcrSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PopTranslate.Core.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="截图与 OCR 设置" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="使用截图翻译快捷键框选屏幕区域后，松开鼠标即可立即执行 OCR 识别并并发翻译。"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Active OCR Provider Selection -->
            <Border Style="{StaticResource PopTranslateSettingsCardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="当前 OCR 识别引擎" FontWeight="SemiBold" />
                            <TextBlock
                                Text="默认采用 Windows 11 系统原生离线 OCR（零配置、极速），也可切换为视觉大模型 OCR 识别复杂公式与多语种排版"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="230"
                            SelectedIndex="{x:Bind ViewModel.ActiveProviderIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Windows 11 原生离线 OCR（默认）" />
                            <ComboBoxItem Content="OpenAI 兼容视觉大模型 OCR" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="自动合并 OCR 识别结果换行" FontWeight="SemiBold" />
                            <TextBlock
                                Text="将截图识别出的视觉折行智能拼接为通顺句子，提升翻译准确度"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="开启"
                            OffContent="关闭"
                            IsOn="{x:Bind ViewModel.AutoMergeOcrLineBreaks, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Windows 11 Native OCR Configuration -->
            <TextBlock Text="Windows 11 原生离线 OCR" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
            <Border Style="{StaticResource PopTranslateSettingsCardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="已安装的 Windows OCR 语言包" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Windows 仅能离线识别已安装对应语言包的文字。如需识别日语、韩语等，请在 Windows 设置 → 时间和语言 → 语言和区域 中添加对应语言。"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.RefreshLanguagesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Language Packs Chips -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.InstalledLanguagePacks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="190"
                                MinItemHeight="32"
                                MinRowSpacing="8"
                                MinColumnSpacing="8"
                                ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:OcrLanguagePackInfo">
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind LanguageTag}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Missing Language Pack Guidance -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ShowMissingLanguagePacksWarning, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Title="未检测到可用的 Windows OCR 语言包"
                        Message="请打开 Windows 设置 → 时间和语言 → 语言和区域 → 添加语言（如中文简体、英语），安装光学字符识别组件后点击「刷新」；或者上方切换为「视觉大模型 OCR」。" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="首选离线识别语言" FontWeight="SemiBold" />
                            <TextBlock
                                Text="默认跟随 Windows 用户首选语言，也可手动锁定特定语言包"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="230"
                            DisplayMemberPath="DisplayLabel"
                            ItemsSource="{x:Bind ViewModel.PreferredLanguageOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedPreferredLanguage, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Vision LLM OCR Configuration -->
            <Grid Margin="0,4,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="视觉大模型 OCR（OpenAI 兼容多模态接口）"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    Padding="10,4"
                    FontSize="12"
                    ToolTipService.ToolTip="一键复制「翻译服务」中首个已配置大模型实例的 Base URL、模型与 API Key"
                    Command="{x:Bind ViewModel.ReuseFirstLlmCredentialsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                        <TextBlock Text="复用首个已配置大模型凭证" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource PopTranslateSettingsCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="视觉 OCR 识别模式" FontWeight="SemiBold" />
                            <TextBlock
                                Text="针对截图内容选择最佳输出结构（使用默认提示词时自动切换为对应专业识别模板）"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="210"
                            VerticalAlignment="Center"
                            SelectedIndex="{x:Bind ViewModel.PromptModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="纯文本识别" />
                            <ComboBoxItem Content="Markdown 表格提取" />
                            <ComboBoxItem Content="LaTeX 公式识别" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBox
                        Header="Vision API Base URL"
                        PlaceholderText="https://api.openai.com/v1"
                        Text="{x:Bind ViewModel.VisionBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Header="视觉模型名称 (Vision Model)"
                            PlaceholderText="gpt-4o-mini / qwen-vl-max / gemini-2.5-flash"
                            Text="{x:Bind ViewModel.VisionModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="从当前 Vision API Base URL 拉取可用模型列表"
                            IsEnabled="{x:Bind ViewModel.CanFetchModels, Mode=OneWay}"
                            Command="{x:Bind ViewModel.FetchModelsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                <TextBlock Text="拉取模型" />
                            </StackPanel>
                        </Button>
                        <NumberBox
                            Grid.Column="2"
                            Header="超时时间（秒）"
                            Minimum="5"
                            Maximum="180"
                            SmallChange="5"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.TimeoutSeconds, Mode=TwoWay}" />
                    </Grid>

                    <ComboBox
                        Header="已拉取的可用模型（点击快速填入）"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="从已拉取模型列表中选择..."
                        Visibility="{x:Bind ViewModel.HasDiscoveredModels, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        ItemsSource="{x:Bind ViewModel.DiscoveredModels, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDiscoveredModel, Mode=TwoWay}" />

                    <PasswordBox
                        Header="Vision API Key（Windows DPAPI 本地加密保存）"
                        PlaceholderText="sk-..."
                        Password="{x:Bind ViewModel.VisionApiKeyPlaintext, Mode=TwoWay}" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="OCR 识别提示词" VerticalAlignment="Center" />
                            <Button
                                Content="恢复默认"
                                HorizontalAlignment="Right"
                                Padding="8,2"
                                FontSize="12"
                                Command="{x:Bind ViewModel.ResetVisionPromptCommand}" />
                        </Grid>
                        <TextBox
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="72"
                            MaxHeight="130"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.VisionPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions & Feedback -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Content="保存 OCR 配置"
                    Command="{x:Bind ViewModel.SaveOcrSettingsCommand}" />

                <Button Command="{x:Bind ViewModel.TestActiveOcrProviderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                        <TextBlock Text="测试当前 OCR 引擎" />
                    </StackPanel>
                </Button>

                <ProgressRing
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsTestingOcr, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsTestingOcr, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasFeedback, Mode=OneWay}"
                IsClosable="False"
                Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}"
                Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
