<UserControl
    x:Class="PopTranslate.App.Controls.TranslationResultCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Compact 42px On-Demand Polish Bar (0 Tokens Until Triggered) -->
        <Border
            Visibility="{x:Bind ViewModel.IsWaitingOnDemand, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            MinHeight="42"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,6,10,6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: [✨ 润色] DisplayName · [StyleLabel ▾] -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="7"
                    VerticalAlignment="Center">
                    <Border
                        Background="{ThemeResource PopTranslatePolishSubtleBackgroundBrush}"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PopTranslatePolishAccentForegroundBrush}"
                            Text="✨ 润色" />
                    </Border>

                    <TextBlock
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        MaxWidth="150"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" />

                    <TextBlock
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="·" />

                    <Button
                        Height="24"
                        Padding="7,0,6,0"
                        Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="选择润色风格并运行"
                        ToolTipService.ToolTip="切换润色风格并立即执行润色">
                        <Button.Flyout>
                            <MenuFlyout
                                Placement="BottomEdgeAlignedLeft"
                                ShouldConstrainToRootBounds="False"
                                Opening="PolishStyleFlyout_Opening"
                                Closed="PolishStyleFlyout_Closed" />
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.CardPolishStyleLabel, Mode=OneWay}" />
                            <FontIcon
                                FontSize="8"
                                Glyph="&#xE70D;"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: [▶ 点击润色] Pill -->
                <Button
                    Grid.Column="1"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RunOnDemandPolishCommand, Mode=OneWay}"
                    AutomationProperties.Name="点击润色"
                    ToolTipService.ToolTip="立即使用此 AI 服务润色原文">
                    <Border
                        Background="{ThemeResource PopTranslatePolishSubtleBackgroundBrush}"
                        BorderBrush="{ThemeResource PopTranslatePolishSubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon
                                FontSize="10"
                                Glyph="&#xE768;"
                                Foreground="{ThemeResource PopTranslatePolishAccentForegroundBrush}" />
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PopTranslatePolishAccentForegroundBrush}"
                                Text="点击润色" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- Active / Completed / Error Unified Fluent 2 Result Card -->
        <Border
            Visibility="{x:Bind ViewModel.ShowFullCard, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12,14,12">
            <StackPanel Spacing="6">
                <!-- Top Header Row (Zero Horizontal Line, Zero Name Truncation) -->
                <Grid
                    Background="Transparent"
                    ColumnSpacing="8"
                    Tapped="Header_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Badge + Responsive DisplayName (+ Polish Style Pill) + Muted Status + Auto-Copied Pill -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <!-- Translation Card Header Left -->
                        <Grid
                            x:Name="TranslateHeaderLeftGrid"
                            Visibility="{x:Bind ViewModel.IsTranslateMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Left"
                            ColumnSpacing="6"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                MinWidth="18"
                                Height="18"
                                Padding="4,0"
                                Background="{ThemeResource PopTranslateAccentSubtleBackgroundBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.ProviderBadgeText, Mode=OneWay}" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" />

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <ProgressRing
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <TextBlock
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                            </StackPanel>

                            <Border
                                Grid.Column="3"
                                Visibility="{x:Bind ViewModel.IsAutoCopied, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource PopTranslateAccentSubtleBackgroundBrush}"
                                CornerRadius="4"
                                Padding="5,1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="已自动复制" />
                            </Border>

                            <FontIcon
                                Grid.Column="4"
                                FontSize="9"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind ViewModel.IsCollapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Glyph="{x:Bind ViewModel.ChevronGlyph, Mode=OneWay}" />
                        </Grid>

                        <!-- Polish Card Header Left -->
                        <Grid
                            x:Name="PolishHeaderLeftGrid"
                            Visibility="{x:Bind ViewModel.IsPolishMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Left"
                            ColumnSpacing="5"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{ThemeResource PopTranslatePolishSubtleBackgroundBrush}"
                                CornerRadius="4"
                                Padding="5,2"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource PopTranslatePolishAccentForegroundBrush}"
                                    Text="✨ 润色" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" />

                            <Button
                                Grid.Column="2"
                                Height="22"
                                Padding="6,0,5,0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="选择润色风格"
                                ToolTipService.ToolTip="切换此卡片的润色风格并重新润色">
                                <Button.Flyout>
                                    <MenuFlyout
                                        x:Name="CardPolishStyleFlyout"
                                        Placement="BottomEdgeAlignedLeft"
                                        ShouldConstrainToRootBounds="False"
                                        Opening="PolishStyleFlyout_Opening"
                                        Closed="PolishStyleFlyout_Closed" />
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.CardPolishStyleLabel, Mode=OneWay}" />
                                    <FontIcon
                                        FontSize="8"
                                        Glyph="&#xE70D;"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel
                                Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <ProgressRing
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <TextBlock
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                            </StackPanel>

                            <Border
                                Grid.Column="4"
                                Visibility="{x:Bind ViewModel.IsAutoCopied, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource PopTranslatePolishSubtleBackgroundBrush}"
                                CornerRadius="4"
                                Padding="5,1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource PopTranslatePolishAccentForegroundBrush}"
                                    Text="已自动复制" />
                            </Border>

                            <FontIcon
                                Grid.Column="5"
                                FontSize="9"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind ViewModel.IsCollapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Glyph="{x:Bind ViewModel.ChevronGlyph, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                    <!-- Right: Compact Controls ONLY (对比 when polish text is ready + 🔊 + 📋) -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <!-- Polish Local Diff Subtle Tinted Ghost Toggle Button (Shown once polish text arrives to avoid crowding loading status) -->
                        <Button
                            Visibility="{x:Bind ViewModel.CanToggleDiff, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Height="26"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="5"
                            Command="{x:Bind ViewModel.ToggleShowDiffCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanToggleDiff, Mode=OneWay}"
                            AutomationProperties.Name="对比原文修改差异"
                            ToolTipService.ToolTip="对比原文修改差异（本地计算，零 Token 消耗）">
                            <Grid Height="26">
                                <Border
                                    Visibility="{x:Bind ViewModel.ShowDiff, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{ThemeResource PopTranslateAccentSubtleBackgroundBrush}"
                                    BorderBrush="{ThemeResource PopTranslateAccentSubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon
                                            FontSize="11"
                                            Glyph="&#xE8A1;"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="对比" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Visibility="{x:Bind ViewModel.IsDiffOff, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="Transparent"
                                    CornerRadius="5"
                                    Padding="7,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon
                                            FontSize="11"
                                            Glyph="&#xE8A1;"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            FontSize="11.5"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="对比" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- TTS Speaker (28x28 Ghost) -->
                        <Button
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleSpeakCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasText, Mode=OneWay}"
                            AutomationProperties.Name="朗读结果"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SpeakTooltip, Mode=OneWay}">
                            <FontIcon
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind ViewModel.SpeakGlyph, Mode=OneWay}" />
                        </Button>

                        <!-- Copy Result (28x28 Ghost) -->
                        <Button
                            Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                            Command="{x:Bind ViewModel.CopyResultCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasText, Mode=OneWay}"
                            AutomationProperties.Name="复制结果"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CopyTooltip, Mode=OneWay}">
                            <FontIcon
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind ViewModel.CopyGlyph, Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Collapsible Body (6px clean spacing below header, no horizontal divider line) -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Spacing="6">

                    <!-- Inline Error Banner -->
                    <Border
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                FontSize="14"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE783;" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                Padding="8,3"
                                FontSize="12"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="重试此服务"
                                Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon FontSize="11" Glyph="&#xE72C;" />
                                    <TextBlock FontSize="12" Text="重试" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Streaming / Reasoning Placeholder -->
                    <TextBlock
                        Visibility="{x:Bind ViewModel.ShowStreamingPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        FontSize="13.5"
                        LineHeight="22"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.StreamingPlaceholderText, Mode=OneWay}" />

                    <!-- Plain Result Text (Live Streaming or Plain Prose) -->
                    <TextBlock
                        Visibility="{x:Bind ViewModel.ShowPlainText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        FontSize="14"
                        LineHeight="23"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.TranslatedText, Mode=OneWay}" />

                    <!-- Native Formatted Result Text (Inline `code`, fenced ```code```, and **bold**) -->
                    <RichTextBlock
                        x:Name="FormattedRichTextBlock"
                        Visibility="{x:Bind ViewModel.ShowFormattedMarkdown, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        FontSize="14"
                        LineHeight="23"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <!-- Polish Local Diff View (RichTextBlock + TextHighlighter, rendered once Completed) -->
                    <RichTextBlock
                        x:Name="DiffRichTextBlock"
                        Visibility="{x:Bind ViewModel.ShowDiffText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        FontSize="14"
                        LineHeight="23"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <!-- Back-Translation Sub-Panel (Translate Mode Only) -->
                    <Border
                        Visibility="{x:Bind ViewModel.IsBackTranslateVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,2,0,0">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.BackTranslateTargetLabel, Mode=OneWay}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <ProgressRing
                                        Width="12"
                                        Height="12"
                                        IsActive="{x:Bind ViewModel.IsBackTranslating, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsBackTranslating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.BackTranslateStatusText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                                    <Button
                                        Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                                        Width="24"
                                        Height="24"
                                        Command="{x:Bind ViewModel.BackTranslateCommand, Mode=OneWay}"
                                        AutomationProperties.Name="重新回译"
                                        ToolTipService.ToolTip="重新回译">
                                        <FontIcon FontSize="11" Glyph="&#xE72C;" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                                        Width="24"
                                        Height="24"
                                        Command="{x:Bind ViewModel.CopyBackTranslationCommand, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.HasBackTranslatedText, Mode=OneWay}"
                                        AutomationProperties.Name="复制回译结果"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.BackTranslateCopyTooltip, Mode=OneWay}">
                                        <FontIcon FontSize="11" Glyph="{x:Bind ViewModel.BackTranslateCopyGlyph, Mode=OneWay}" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource PopTranslateMicroIconButtonStyle}"
                                        Width="24"
                                        Height="24"
                                        Command="{x:Bind ViewModel.DismissBackTranslationCommand, Mode=OneWay}"
                                        AutomationProperties.Name="收起回译"
                                        ToolTipService.ToolTip="收起回译">
                                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Back-Translation Inline Error -->
                            <Border
                                Visibility="{x:Bind ViewModel.HasBackTranslateError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind ViewModel.BackTranslateErrorMessage, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Content="重试"
                                        Padding="7,2"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="重试回译"
                                        Command="{x:Bind ViewModel.BackTranslateCommand, Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <!-- Back-Translation Streaming Placeholder -->
                            <TextBlock
                                Visibility="{x:Bind ViewModel.ShowBackTranslatePlaceholder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="正在回译..." />

                            <!-- Back-Translated Text -->
                            <TextBlock
                                Visibility="{x:Bind ViewModel.HasBackTranslatedText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                FontSize="13"
                                LineHeight="20"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.BackTranslatedText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Quiet Bottom Contextual Action Row (Visible When HasText & Not IsWaitingOnDemand) -->
                    <StackPanel
                        Visibility="{x:Bind ViewModel.ShowContextualActionRow, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Orientation="Horizontal"
                        Spacing="14"
                        Margin="0,8,0,0">

                        <!-- Write-Back on Translation Card (Quiet Link) -->
                        <Button
                            Style="{StaticResource PopTranslateContextualLinkButtonStyle}"
                            Visibility="{x:Bind ViewModel.ShowTranslateWriteBackButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{x:Bind ViewModel.WriteBackCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanWriteBack, Mode=OneWay}"
                            AutomationProperties.Name="回填替换原文"
                            ToolTipService.ToolTip="{x:Bind ViewModel.WriteBackTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind ViewModel.WriteBackGlyph, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.WriteBackLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <!-- Write-Back on Polish Card (Gently Highlighted in Polish Accent!) -->
                        <Button
                            Style="{StaticResource PopTranslateContextualLinkButtonStyle}"
                            Padding="0"
                            Visibility="{x:Bind ViewModel.ShowPolishWriteBackButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{x:Bind ViewModel.WriteBackCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanWriteBack, Mode=OneWay}"
                            AutomationProperties.Name="回填替换原文"
                            ToolTipService.ToolTip="{x:Bind ViewModel.WriteBackTooltip, Mode=OneWay}">
                            <Border
                                Background="{ThemeResource PopTranslatePolishSubtleBackgroundBrush}"
                                CornerRadius="5"
                                Padding="7,2">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{ThemeResource PopTranslatePolishAccentForegroundBrush}"
                                        Glyph="{x:Bind ViewModel.WriteBackGlyph, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource PopTranslatePolishAccentForegroundBrush}"
                                        Text="{x:Bind ViewModel.WriteBackLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Back-Translate Verification (Translation Cards) -->
                        <Button
                            Style="{StaticResource PopTranslateContextualLinkButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsTranslateMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{x:Bind ViewModel.BackTranslateCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanBackTranslate, Mode=OneWay}"
                            AutomationProperties.Name="回译核对"
                            ToolTipService.ToolTip="反向回译以核对译文准确度">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8AB;" />
                                <TextBlock
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="回译核对" />
                            </StackPanel>
                        </Button>

                        <!-- Retry Link -->
                        <Button
                            Style="{StaticResource PopTranslateContextualLinkButtonStyle}"
                            Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}"
                            AutomationProperties.Name="重试"
                            ToolTipService.ToolTip="{x:Bind ViewModel.RetryTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE72C;" />
                                <TextBlock
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="重试" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
